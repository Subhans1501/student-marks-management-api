{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "MarksApi",
    "Audience": "MarksApiClients",
    "LifetimeMinutes": 60
  },
  "DepartmentRules": {
    "PassMark": 50
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "RateLimiting": {
    "LoginPermitLimit": 30,
    "LoginWindowSeconds": 60
  }
}

